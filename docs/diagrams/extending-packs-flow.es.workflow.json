  },
  "lanes": [
    {
      "id": "detection",
      "label": "1. Detección · 1×/run"
    },
    {
      "id": "generic",
      "label": "Fallback: generic"
    },
    {
      "id": "resolution",
      "label": "2. Resolución de ruta · 1×/run"
    },
    {
      "id": "leaves",
      "label": "3. Consumo: hojas"
    },
    {
      "id": "env",
      "label": "3. Consumo: env-checker"
    },
    {
      "id": "pattern",
      "label": "3. Consumo: advisor/modeler"
    }
  ],
  "nodes": [
    {
      "id": "R",
      "lane": "detection",
      "col": 0,
      "type": "external",
      "label": "Repo target",
      "width": 170
    },
    {
      "id": "S",
      "lane": "detection",
      "col": 1,
      "type": "database",
      "label": "scripts/mem-scan.sh",
      "width": 250
    },
    {
      "id": "CP",
      "lane": "detection",
      "col": 2,
      "type": "backend",
      "label": ".swarm/context-pack.md",
