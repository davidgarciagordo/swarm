    },
    {
      "id": "GEN",
      "lane": "generic",
      "col": 2,
      "type": "backend",
      "label": "stack: generic",
      "width": 210
    },
    {
      "id": "ABS",
      "lane": "resolution",
      "col": 3,
      "type": "backend",
      "label": "ls -d skills/pack-<name>",
      "sublabel": "→ <ruta absoluta>",
      "width": 250
    },
    {
      "id": "L1",
      "lane": "leaves",
      "col": 4,
      "type": "backend",
      "label": "8 hojas pack-aware",
      "sublabel": "Read de commands/conventions/boundaries/precedents → juicio propio",
      "width": 380
    },
    {
      "id": "L2",
      "lane": "env",
      "col": 4,
      "type": "backend",
      "label": "env-checker",
      "sublabel": "vía requirements-orchestrator",
