    },
    {
      "from": "S",
      "to": "GEN",
      "role": "branch",
      "variant": "dashed",
      "label": "ningún marcador casa"
    },
    {
      "from": "CP",
      "to": "ABS",
      "role": "main"
    },
    {
      "from": "ABS",
      "to": "L1",
      "role": "main",
      "label": "cabecera pack: <ruta>"
    },
    {
      "from": "ABS",
      "to": "L2",
      "role": "main",
      "label": "--pack <ruta>/requirements.json"
    },
    {
      "from": "CP",
      "to": "L3",
      "role": "branch",
      "variant": "dashed",
      "label": "solo línea stack:"
    }
