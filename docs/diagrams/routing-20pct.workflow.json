  "nodes": [
    {
      "id": "A",
      "lane": "ask",
      "col": 0,
      "type": "external",
      "label": "Owner",
      "sublabel": "\"Add login to this app\"",
      "width": 260
    },
    {
      "id": "B",
      "lane": "sizing",
      "col": 1,
      "type": "backend",
      "label": "/swarm:run sizing",
      "sublabel": "probe: touches auth/, existing app",
      "width": 340
    },
    {
      "id": "C",
      "lane": "sizing",
      "col": 2,
      "type": "backend",
      "label": "path: light",
      "sublabel": "bounded feature, one focused component",
