      "items": [
        "- path: light · bounded feature, decision already made",
        "- spawn context-pack: several agents need the same repo context",
        "- spawn security-auditor: diff touches auth/",
        "- spawn blind-judge (plan): high blast radius",
        "- spawn test-writer: maybe, if native skipped tests",
        "- skipped: discovery (decision already made)",
        "- skipped: performance lens (not touched)",
        "- skipped: data-model lens (not touched)",
        "- skipped: delivery (push only on explicit request)"
      ]
    },
    {
      "dot": "slate",
      "title": "Illustrative example",
      "items": [
        "Not a measured run — the pulled-component set varies by diff shape/size",
        "Spawn/skip lines follow sizing.md's real log format"
      ]
    }
  ]
