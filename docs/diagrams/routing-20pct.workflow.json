  "edges": [
    { "from": "A", "to": "B", "role": "main" },
    { "from": "B", "to": "C", "role": "main", "label": "cheap repo probe" },
    { "from": "C", "to": "D", "role": "main", "label": "tier = light" },
    { "from": "D", "to": "P1", "role": "branch", "variant": "dashed", "label": "spawn: shared context needed" },
    { "from": "P1", "to": "P2", "role": "main", "label": "spawn: diff touches auth/" },
    { "from": "P1", "to": "P3", "role": "main", "label": "spawn: high blast radius" },
