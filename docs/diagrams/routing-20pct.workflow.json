    { "id": "sizing", "label": "Sizing (Step 0)" },
    { "id": "native", "label": "Native plan+code" },
    { "id": "pulled", "label": "Swarm - pulled" },
    { "id": "skipped", "label": "Skipped (not needed)", "variant": "exception" }
