{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "The /swarm:run flow",
    "output": "run-flow.html",
    "animation": "none",
    "visual_preset": "classic",
    "quality_profile": "standard"
  },
  "lanes": [
    {
      "id": "top",
      "label": "Trigger & interpretation"
    },
    {
      "id": "shortcut",
      "label": "Direct tier (no run)"
    },
    {
      "id": "exception",
      "label": "Objective unconfirmed",
      "variant": "exception"
    },
    {
      "id": "bottom",
      "label": "Run opened: memory & discovery"
    },
    {
      "id": "close",
      "label": "Close"
    }
  ],
  "nodes": [
    {
      "id": "A",
      "lane": "top",
      "col": 0,
      "type": "external",
      "label": "User: /swarm:run \"<goal>\"",
      "sublabel": "[--tier]",
      "width": 300
    },
    {
      "id": "B",
      "lane": "top",
      "col": 1,
      "type": "security",
      "label": "Objective ambiguous?",
      "sublabel": "root's own judgment",
      "width": 250
    },
    {
      "id": "C",
      "lane": "top",
      "col": 2,
      "type": "security",
      "label": "AskUserQuestion",
      "sublabel": "interpretation + alternatives + free rewrite",
      "width": 420
    },
    {
      "id": "D",
      "lane": "top",
      "col": 3,
      "type": "backend",
      "label": "Classify tier",
      "sublabel": "direct / light / full",
      "width": 250
    },
    {
      "id": "S1",
      "lane": "shortcut",
      "col": 3,
      "type": "backend",
      "label": "OK",
      "sublabel": "no run opened",
      "width": 170
    },
    {
      "id": "X1",
      "lane": "exception",
      "col": 2,
      "type": "security",
      "label": "BLOCKED",
      "sublabel": "objective unconfirmed",
      "width": 250
    },
    {
      "id": "E",
      "lane": "bottom",
      "col": 0,
      "type": "database",
      "label": "Open run",
      "sublabel": "run-id, .swarm/run/<id>/",
      "width": 250
    },
    {
      "id": "F",
      "lane": "bottom",
      "col": 1,
      "type": "database",
      "label": "memory-orchestrator",
      "sublabel": "checks staleness (tree-hash)",
      "width": 300
    },
    {
      "id": "G",
      "lane": "bottom",
      "col": 2,
      "type": "database",
      "label": "memory-builder",
      "sublabel": "rebuilds pack if stale",
      "width": 250
    },
    {
      "id": "H",
      "lane": "bottom",
      "col": 3,
      "type": "backend",
      "label": "discovery-orchestrator",
      "sublabel": "4 leaves, one batch",
      "width": 250
    },
    {
      "id": "I",
      "lane": "bottom",
      "col": 4,
      "type": "security",
      "label": "AskUserQuestion",
      "sublabel": "ONE call, all questions",
      "width": 250
    },
    {
      "id": "J",
      "lane": "bottom",
      "col": 5,
      "type": "database",
      "label": "Write decision",
      "sublabel": "raw: + objective: + answers",
      "width": 300
    },
    {
      "id": "K",
      "lane": "close",
      "col": 0,
      "type": "database",
      "label": "Curate",
      "sublabel": "close the run",
      "width": 170
    },
    {
      "id": "L",
      "lane": "close",
      "col": 1,
      "type": "backend",
      "label": "DONE",
      "sublabel": "evidence: files=N cmds=M turns=k/max",
      "width": 360
    }
  ],
  "edges": [
    {
      "from": "A",
      "to": "B",
      "role": "main"
    },
    {
      "from": "B",
      "to": "D",
      "role": "main",
      "label": "not ambiguous"
    },
    {
      "from": "B",
      "to": "C",
      "role": "branch",
      "variant": "dashed",
      "label": "ambiguous"
    },
    {
      "from": "C",
      "to": "D",
      "role": "main",
      "label": "owner resolves"
    },
    {
      "from": "C",
      "to": "X1",
      "role": "branch",
      "variant": "dashed",
      "label": "owner cancels"
    },
    {
      "from": "D",
      "to": "S1",
      "role": "branch",
      "variant": "dashed",
      "label": "tier = direct"
    },
    {
      "from": "D",
      "to": "E",
      "role": "main",
      "label": "tier = light / full"
    },
    {
      "from": "E",
      "to": "F",
      "role": "main"
    },
    {
      "from": "F",
      "to": "G",
      "role": "branch",
      "variant": "dashed",
      "label": "pack stale"
    },
    {
      "from": "F",
      "to": "H",
      "role": "main",
      "label": "product goal"
    },
    {
      "from": "G",
      "to": "H",
      "role": "main"
    },
    {
      "from": "H",
      "to": "I",
      "role": "main"
    },
    {
      "from": "I",
      "to": "J",
      "role": "main"
    },
    {
      "from": "J",
      "to": "K",
      "role": "main"
    },
    {
      "from": "K",
      "to": "L",
      "role": "main"
    }
  ]
}
